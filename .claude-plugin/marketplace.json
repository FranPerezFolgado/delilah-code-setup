    "name": "FranPerezFolgado"
  },
  "plugins": [
    {
      "name": "delilah-code-setup",
      "source": "./",
      "description": "Minimal, opinionated Claude Code setup — semantic doc search, token-efficient shell, code graph navigation, and spec-driven feature development.",
