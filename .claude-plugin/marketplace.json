      "agents": [
        "./agents/code-researcher.md",
        "./agents/doc-searcher.md",
        "./agents/commit-writer.md",
        "./agents/doc-checker.md",
        "./agents/security-reviewer.md",
        "./agents/code-quality-reviewer.md",
